<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="base_location_city_view_form" model="ir.ui.view">
		<field name="name">base_location.city.view.form</field>
		<field name="model">base_location.city</field>

		<field name="arch" type="xml">
			<form string="City">
				<sheet>

					<group>
						<field name="name"/>
						<field name="state_id"/>
					</group>

				</sheet>
			</form>
		</field>
	</record>

	<record id="base_location_city_view_list" model="ir.ui.view">
		<field name="name">base_location.city.view.list</field>
		<field name="model">base_location.city</field>

		<field name="arch" type="xml">
			<list string="Cities">

				<field name="name"/>
				<field name="state_id"/>

			</list>
		</field>
	</record>

	<record id="base_location_city_view_search" model="ir.ui.view">
		<field name="name">base_location.city.view.search</field>
		<field name="model">base_location.city</field>

		<field name="arch" type="xml">
			<search string="Search Cities">
				<field name="name"/>
				<field name="state_id"/>
			</search>
		</field>
	</record>

	<record id="base_location_city_action" model="ir.actions.act_window">
		<field name="name">Cities</field>
		<field name="res_model">base_location.city</field>
		<field name="view_mode">list,form</field>
	</record>

	<menuitem
		id="base_location_city_menu"
		name="Cities"
		parent="base_location_root_menu"
		action="base_location_city_action"
		/>

</odoo>
