<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="library_state_view_form" model="ir.ui.view">
		<field name="name">library.state.view.form</field>
		<field name="model">library.state</field>

		<field name="arch" type="xml">
			<form string="State">
				<sheet>

					<group>
						<field name="name"/>
					</group>

				</sheet>
			</form>
		</field>
	</record>

	<record id="library_state_view_list" model="ir.ui.view">
		<field name="name">library.state.view.list</field>
		<field name="model">library.state</field>

		<field name="arch" type="xml">
			<list string="States">
				<field name="name"/>
			</list>
		</field>
	</record>

	<record id="library_state_view_search" model="ir.ui.view">
		<field name="name">library.state.view.search</field>
		<field name="model">library.state</field>

		<field name="arch" type="xml">
			<search string="Search States">

				<field name="name"/>
				<separator/>

			</search>
		</field>
	</record>

	<record id="library_state_action" model="ir.actions.act_window">
		<field name="name">States</field>
		<field name="res_model">library.state</field>
		<field name="view_mode">list,form</field>
	</record>

	<menuitem
		id="library_state_menu"
		name="States"
		parent="library_root_menu"
		action="library_state_action"
		/>

</odoo>
