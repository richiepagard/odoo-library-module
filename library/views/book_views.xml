<?xml version="1.0" encoding="UTF-8"?>

<odoo>

	<record id="library_book_view_form" model="ir.ui.view">

		<field name="name">library.book.view.form</field>
		<field name="model">library.book</field>

		<field name="arch" type="xml">
			<form string="Book">
				<sheet>

					<group>
						<field name="title"/>
						<field name="author"/>
						<field name="isbn"/>
						<field name="publish_year"/>
						<field name="age"/>
						<field name="pages"/>
						<field name="state"/>
						<field name="is_active"/>
					</group>

					<group>
						<field name="description" widget="markdown"/>
					</group>

				</sheet>
			</form>
		</field>

	</record>

	<record id="library_book_view_list" model="ir.ui.view">

		<field name="name">library.book.view.list</field>
		<field name="model">library.book</field>

		<field name="arch" type="xml">
			<list string="Books">

				<field name="title"/>
				<field name="author"/>
				<field name="isbn"/>
				<field name="publish_year"/>
				<field name="pages"/>
				<field name="state"/>

			</list>
		</field>

	</record>

	<record id="library_book_view_search" model="ir.ui.view">

		<field name="name">library.book.view.search</field>
		<field name="model">library.book</field>

		<field name="arch" type="xml">
			<search string="Search Books">

				<field name="title"/>
				<field name="isbn"/>
				<field name="author"/>
				<separator/>

				<filter
					string="Available"
					name="available"
					domain="[('state', '=', 'available')]"
					/>

				<filter
					string="Lost"
					name="lost"
					domain="[('state', '=', 'lost')]"
					/>

			</search>
		</field>

	</record>

	<record id="library_book_action" model="ir.actions.act_window">

		<field name="name">Books</field>
		<field name="res_model">library.book</field>
		<field name="view_mode">list,form</field>

	</record>


	<menuitem id="library_root_menu" name="Library"/>

	<menuitem
		id="library_book_menu"
		name="Books"
		parent="library_root_menu"
		action="library_book_action"
		/>

</odoo>
